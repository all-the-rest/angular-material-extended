{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@all-the.rest/mat-extended": ["./packages/mat-extended/src/index.ts"],
      "@all-the.rest/mat-extended/cropper": [
        "./packages/mat-extended/cropper/src/index.ts"
      ],
      "@all-the.rest/mat-extended/data-table": [
        "./packages/mat-extended/data-table/src/index.ts"
      ],
      "@all-the.rest/mat-extended/dialog": [
        "./packages/mat-extended/dialog/src/index.ts"
      ],
      "@all-the.rest/mat-extended/file-upload": [
        "./packages/mat-extended/file-upload/src/index.ts"
      ],
      "@all-the.rest/mat-extended/toast": [
        "./packages/mat-extended/toast/src/index.ts"
      ],
      "@all-the.rest/mat-extended/menu": [
        "./packages/mat-extended/menu/src/index.ts"
      ],
      "@all-the.rest/mat-extended/file-manager": [
        "./packages/mat-extended/file-manager/src/index.ts"
      ],
      "@all-the.rest/mat-extended/breadcrumb": [
        "./packages/mat-extended/breadcrumb/src/index.ts"
      ],
      "@all-the.rest/mat-extended/multi-select": [
        "./packages/mat-extended/multi-select/src/index.ts"
      ],
      "@all-the.rest/mat-extended/autocomplete": [
        "./packages/mat-extended/autocomplete/src/index.ts"
      ],
      "@all-the.rest/mat-extended/on-this-page": [
        "./packages/mat-extended/on-this-page/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
